# ==========================================================================
# Inventory app — environment variables
#
# Copy to `.env` for `docker compose` deploys, or `.env.local` for bare
# `next dev`/Prisma use. Never commit real secrets — this file holds
# placeholders and format examples only.
#
# "required" below means: the app throws/misbehaves at runtime without it,
# AND it is actually wired into docker-compose.yml's `app`/`migrate` service
# environment (checked against docker-compose.yml as of this pass). Anything
# else is optional — the code has a fallback default or degrades gracefully.
# ==========================================================================

# ---- Database ------------------------------------------------------------
# MYSQL_* feed docker-compose.yml's `${VAR}` interpolation for the db/migrate/
# app/backup/sync services. DATABASE_URL itself is only read directly by the
# app when NOT run through docker-compose (e.g. bare `next dev`/Prisma) —
# docker-compose.yml builds its own DATABASE_URL from MYSQL_PASSWORD and
# ignores this line.
MYSQL_ROOT_PASSWORD=                                  # required
MYSQL_PASSWORD=                                       # required
DATABASE_URL=mysql://inventory:${MYSQL_PASSWORD}@db:3306/inventory?connection_limit=20   # required (non-compose use only)

# ---- Auth: NextAuth + Google OAuth ----------------------------------------
NEXTAUTH_URL=http://localhost:3000                    # required — public base URL of this app
NEXTAUTH_SECRET=                                      # required — 32+ chars; generate: openssl rand -base64 32
GOOGLE_CLIENT_ID=                                     # required — from console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_SECRET=                                 # required
# Comma-separated Workspace domains allowed to sign up/sign in.
ALLOWED_EMAIL_DOMAINS=advancedresearchpep.com         # optional, default: advancedresearchpep.com

# ---- Encryption at rest (integration API credentials) ---------------------
# base64-encoded, MUST decode to exactly 32 bytes (AES-256-GCM key).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=                                       # required — app throws at runtime if unset/malformed
# ENCRYPTION_KEY is also required for AI-provider credential operations (the
# admin panel encrypts provider API keys with it) and by the MCP sidecar.

# ---- AI layer / MCP sidecar -----------------------------------------------
# The read-only MCP sidecar is DISABLED by default. Deploying the compose
# `mcp` service exposes nothing until ENABLE_MCP=1 (the service logs and exits
# 0 while disabled). AI-provider API keys are NOT configured here — they live
# encrypted in the database, entered via Admin -> Settings -> AI.
ENABLE_MCP=0                                          # optional, default 0 (sidecar off)

# ---- Cron endpoints (bearer-token protected) ------------------------------
# Every /api/cron/* route returns 401 without this (app still boots fine).
CRON_SECRET=                                          # required for cron features — bearer token for /api/cron/*

# ---- External order sync (Shopify/WooCommerce) ----------------------------
# Shared secret between the app and the `sync` sidecar container.
INTERNAL_SYNC_TOKEN=                                  # required for sync features
# The rest configure the `sync` sidecar (scripts/scheduled-external-sync.js):
ENABLE_EXTERNAL_SYNC=0                                # optional, default 0 (off) — 1 enables the sidecar
EXTERNAL_SYNC_INTERVAL_MINUTES=15                     # optional, default 15
EXTERNAL_SYNC_LOOKBACK_DAYS=1                          # optional, default 1
EXTERNAL_SYNC_MAX_ORDERS=250                          # optional, default 250
INTERNAL_SYNC_URL=http://app:3000/api/cron/external-sync   # optional, default shown (in-network URL)

# ---- Platform writes (egress lockdown, Lane 6) ----------------------------
# The app must NEVER accidentally alter a live store. Writes are DEFAULT-DENY.
#
# PLATFORM_WRITES: byte-exact "off" | "dry-run" | "on". ANY other value (case
#   variant, whitespace, typo, blank) fails CLOSED to "off" and turns healthz RED.
#   - off      (DEFAULT, and the correct PROD value): no platform write is ever sent.
#   - dry-run  : the exact method/URL/body that WOULD be sent is logged + audited;
#                zero bytes leave. Use this to verify a push before ever enabling it.
#   - on       : writes are sent, but ONLY for capabilities in the allowlist below,
#                ONLY for integrations whose own flag is on, ONLY with a write
#                credential present, and ONLY while the emergency stop is off.
# PLATFORM_WRITE_CAPABILITIES: comma list, default EMPTY. e.g. "stock_status".
#   order_status writes require the literal token "order_status" here. One unknown
#   or duplicate token empties the WHOLE allowlist (fail closed).
# The runtime emergency stop (SystemSetting platformWritesKillSwitch) can block
# everything instantly from the admin ops dashboard with no redeploy.
PLATFORM_WRITES=off                                   # off | dry-run | on  (default off)
PLATFORM_WRITE_CAPABILITIES=                          # e.g. stock_status  (default empty)

# ---- Webhooks (Shopify/WooCommerce) ---------------------------------------
# Per-integration secrets stored (encrypted) in the DB take precedence; these
# are only used as a GLOBAL FALLBACK when an integration has none configured.
# NOTE (Lane 6): the app NO LONGER falls back to the API credential for webhook
# signature verification — a dedicated signing secret is required (per-integration
# webhookSecret or the env fallback below).
SHOPIFY_WEBHOOK_SECRET=                               # optional — fallback signing secret
WOOCOMMERCE_WEBHOOK_SECRET=                           # optional — fallback signing secret
SHOPIFY_API_VERSION=2025-10                           # optional, default: 2025-10
# Dump webhook headers/body to logs. Both are hard-disabled in production
# regardless of value (see app/api/webhooks/[integrationId]/route.ts).
WEBHOOK_DEBUG_HEADERS=0                               # optional, default 0, dev-only
WEBHOOK_DEBUG_BODY=0                                  # optional, default 0, dev-only (not wired in docker-compose)

# ---- Email (SendGrid) — optional, degrades gracefully ---------------------
# If SENDGRID_API_KEY is unset, EmailService logs a warning and skips sending
# instead of crashing. NOTE: neither var is currently forwarded to the `app`
# service in docker-compose.yml, so email sending is effectively off in the
# containerized deploy until that's added — set here for bare-metal/next-dev
# use in the meantime.
SENDGRID_API_KEY=                                     # optional — "SG...."; unset = emails silently skipped
SENDGRID_FROM_EMAIL=alerts@advancedresearchpep.com    # optional, default: alerts@advancedresearchpep.com
TEMPLATE_ID=                                          # optional — SendGrid dynamic template id; unset = inline HTML

# ---- Admin bootstrap (one-time ops script, not read by the running app) ---
# Comma-separated emails consumed only by `npm run admin:promote`
# (scripts/promote-admin.js) to grant the first admin account(s).
BOOTSTRAP_ADMIN_EMAILS=

# ---- Analytics rebuild sidecar (scripts/scheduled-analytics-rebuild.js) ---
ENABLE_ANALYTICS_REBUILD=0                            # optional, default 0 (off)
ANALYTICS_REBUILD_URL=http://app:3000/api/cron/analytics-rebuild   # optional, default shown
ANALYTICS_REBUILD_TICK_MINUTES=30                     # optional, default 30
ANALYTICS_NIGHTLY_HOUR_UTC=3                          # optional, default 3 (UTC hour of nightly rebuild)
ANALYTICS_FULL_DOW=0                                  # optional, default 0=Sunday (weekly full-rebuild day)
ANALYTICS_FULL_HOUR_UTC=4                             # optional, default 4
ANALYTICS_SNAPSHOT_NIGHTLY_DAYS=3                     # optional, default 3
# Read by the app route itself (app/api/cron/analytics-rebuild), no
# docker-compose entry — code default applies if unset either way.
ANALYTICS_SALES_NIGHTLY_LOOKBACK_HOURS=36             # optional, default 36
ANALYTICS_SALES_NIGHTLY_ROLLING_DAYS=14               # optional, default 14

# ---- Misc runtime ----------------------------------------------------------
# Matches the db_backups volume mount in docker-compose.yml; only change if
# you remount the backup volume elsewhere.
BACKUP_DIR=/backup                                    # optional, default: /backup
# Shown in /api/diagnostics only — not enforced as real CORS/origin
# allowlisting anywhere in the codebase today.
ALLOWED_ORIGINS=                                      # optional, cosmetic (diagnostics display only)

# Day-bucketing (reports/analytics) assumes UTC. The Docker image pins
# TZ=UTC at build time (see Dockerfile) — this is NOT read from this file.
# Only relevant if you run `next dev`/scripts on a host with a different
# local timezone and want to match production's day boundaries.
# TZ=UTC

# ---- Deploy topology (compose.stack.yml only; not read by app code) -------
# External Docker network the reverse proxy attaches to.
STACK_NETWORK_NAME=stack_network                      # optional, default: stack_network

# ---- Dev-only / one-time ops scripts (never read by the running app) ------
# Each only matters if you invoke the specific script directly.
# ADMIN_SESSION_TOKEN=                    # scripts/test-mass-update-pagination.js (manual QA)
# NEXT_PUBLIC_URL=http://localhost:3000   # same script's target base URL
# AUTH_TOKEN=                             # scripts/test-performance.js (manual perf test)
# TEST_URL=http://localhost:3000          # same script's target base URL
# APPLY_CHANGES=true                      # scripts/backfill-product-variants.js; unset = dry run
# SHOPIFY_API_SECRET_KEY=                 # scripts/verify-shopify-hmac.js (manual HMAC check tool)

# ---- Removed / deprecated — do not use or re-add ---------------------------
# FusionAuth was evaluated and abandoned before launch; zero code references
# remain (auth runs entirely on NextAuth + Google OAuth above).
#   FUSIONAUTH_ISSUER / FUSIONAUTH_CLIENT_ID / FUSIONAUTH_SECRET / FUSIONAUTH_TENANT_ID
# AUTH_SECRET / AUTH_URL / AUTH_TRUST_HOST are dead leftovers (this app runs
# next-auth v4, which reads NEXTAUTH_SECRET/NEXTAUTH_URL above, not these).
# SMS/Twilio support (SMS_ENABLED) is being removed from the codebase; do not
# document or re-introduce it here.
