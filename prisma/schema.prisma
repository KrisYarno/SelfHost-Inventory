generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int                      @id @default(autoincrement())
  username               String                   @db.VarChar(255)
  passwordHash           String?                  @db.VarChar(255)
  isAdmin                Boolean                  @default(false)
  email                  String                   @unique(map: "email") @db.VarChar(255)
  isApproved             Boolean                  @default(false)
  deletedAt              DateTime?                @db.DateTime(0)
  defaultLocationId      Int                      @default(1)
  emailAlerts            Boolean?                 @default(false)
  minLocationEmailAlerts Boolean                  @default(false)
  minCombinedEmailAlerts Boolean                  @default(false)
  failedLoginAttempts    Int                      @default(0)
  lockedUntil            DateTime?                @db.DateTime(0)
  inventory_logs         inventory_logs[]
  notificationHistory    NotificationHistory[]
  deletedProducts        Product[]                @relation("DeletedProducts")
  auditLogs              AuditLog[]
  companies              UserCompany[]
  fulfilledOrders        ExternalOrder[]
  stagingReceived        StagingItem[]            @relation("StagingReceivedBy")
  stagingGraduated       StagingItem[]            @relation("StagingGraduatedBy")
  stagingCounted         StagingItem[]            @relation("StagingCountedBy")
  shipmentsCreated       InboundShipment[]        @relation("shipmentCreator")
  createdProducts        Product[]                @relation("ProductCreatedBy")
  reviewedProducts       Product[]                @relation("ProductReviewedBy")
  scratchpadCreated      ProductScratchpadPrice[] @relation("ScratchpadCreatedBy")
  scratchpadUpdated      ProductScratchpadPrice[] @relation("ScratchpadUpdatedBy")
  // Lane 4 (D7): ApiToken back-relations. Named to avoid the secret-shaped field
  // scan (`token`/`key`/`hash`) in change-tracking-guards — these are relation
  // fields (row collections), never credential values; the digest lives in
  // ApiToken.tokenHash (denylisted).
  apiClientsOwned        ApiToken[]               @relation("ApiTokenOwner")
  apiClientsCreated      ApiToken[]               @relation("ApiTokenCreatedBy")
  assistantThreads       AssistantThread[]
  locations              Location                 @relation(fields: [defaultLocationId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_default_location")

  @@index([defaultLocationId], map: "fk_user_default_location")
  @@index([deletedAt], map: "idx_user_deleted")
  @@map("users")
}

model Product {
  id                Int                   @id @default(autoincrement())
  name              String                @db.VarChar(255)
  baseName          String?               @db.VarChar(150)
  variant           String?               @db.VarChar(100)
  unit              String?               @db.VarChar(20)
  numericValue      Decimal?              @db.Decimal(10, 2)
  quantity          Int                   @default(0)
  location          Int                   @default(1)
  lowStockThreshold Int?
  // Lane 6 (R-D3 / review B2): NULL = cost unknown; an explicit 0 = genuinely free.
  // The DB default is dropped so a create can no longer silently mint a "$0.00"
  // valuation out of "we don't know". Legacy zeros are backfilled to NULL by
  // migration 20260714130000_lane6_cost_nullable.
  costPrice         Decimal?              @db.Decimal(10, 2)
  // W0-RETAIL (spec §4): NULL = retail unknown; an explicit 0 = genuinely free.
  // The DB default is dropped so a create can no longer silently mint a "$0.00"
  // valuation out of "we don't know" (mirrors costPrice). Legacy zeros are
  // backfilled to NULL by migration 20260714210000_retail_price_nullable.
  retailPrice       Decimal?              @db.Decimal(10, 2)
  deletedAt         DateTime?             @db.DateTime(0)
  deletedBy         Int?
  approvalStatus    ProductApprovalStatus @default(APPROVED)
  createdBy         Int?
  reviewedBy        Int?
  reviewedAt        DateTime?
  createdByUser     User?                 @relation("ProductCreatedBy", fields: [createdBy], references: [id])
  reviewedByUser    User?                 @relation("ProductReviewedBy", fields: [reviewedBy], references: [id])
  stagingResolved   StagingItem[]         @relation("StagingResolvedProduct")

  // Retail Price Sync: points at the ONE ProductLink whose WC regular_price
  // should be pulled into retailPrice on manual sync. NULL = manual pricing.
  priceSourceLinkId String?
  priceSourceLink   ProductLink? @relation("PriceSource", fields: [priceSourceLinkId], references: [id], onDelete: SetNull)

  inventory_logs      inventory_logs[]
  notificationHistory NotificationHistory[]
  product_locations   product_locations[]
  deletedByUser       User?                    @relation("DeletedProducts", fields: [deletedBy], references: [id])
  productLinks        ProductLink[]
  bundleComponents    BundleComponent[]
  scratchpadPrices    ProductScratchpadPrice[]
  stockSnapshots      ProductStockSnapshot[]
  salesFacts          ProductSalesFact[]
  reorderConfig       ProductReorderConfig?

  @@index([priceSourceLinkId], map: "idx_price_source")
  @@index([baseName, numericValue, variant], map: "idx_product_sorting")
  @@index([deletedAt], map: "idx_deleted")
  @@index([name], map: "idx_products_name_fulltext")
  @@index([baseName], map: "idx_products_baseName_fulltext")
  @@index([variant], map: "idx_products_variant_fulltext")
  @@index([baseName, variant, name], map: "idx_products_search_composite")
  @@index([deletedBy], map: "products_deletedBy_fkey")
  @@index([approvalStatus], map: "idx_product_approval_status")
  @@index([id, baseName, variant, name], map: "idx_products_bulk_lookup")
  @@map("products")
}

model ProductScratchpadPrice {
  id        Int      @id @default(autoincrement())
  productId Int
  label     String   @db.VarChar(120)
  value     String?  @db.VarChar(255)
  note      String?  @db.Text
  sortOrder Int      @default(0)
  version   Int      @default(0)
  createdBy Int?
  updatedBy Int?
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @default(now()) @updatedAt @db.DateTime(0)

  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdByUser User?   @relation("ScratchpadCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?   @relation("ScratchpadUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder], map: "idx_scratchpad_product_sort")
  @@index([label], map: "idx_scratchpad_label")
  @@map("product_scratchpad_prices")
}

// Reorder configuration (Lane "reorder-points"). ADOPTED from the orphaned
// 20251204_add_reorder_config migration — the tables have shipped on every migrated
// DB but were never in schema.prisma. Fields match that DDL exactly, plus the two
// columns 20260714200000_lane_reorder_adopt_config adds (defaultTargetCoverageMultiple,
// minEvidenceEvents). See lib/reorder-config.ts for the inheritance/resolver.
model GlobalReorderSettings {
  id                            Int      @id @default(1)
  defaultLeadTimeDays           Int      @default(14)
  // The flat policy-buffer default (bufferDays). Column name kept from the orphaned
  // DDL; the domain renamed "safety stock" -> "bufferDays" (no service-level model).
  defaultSafetyStockDays        Int      @default(7)
  // NEW (D5 order-up-to multiple) — guarded-added by 20260714200000.
  defaultTargetCoverageMultiple Int      @default(2)
  // NEW (min-evidence gate) — guarded-added by 20260714200000.
  minEvidenceEvents             Int      @default(3)
  holdingCostRate               Decimal  @default(0.25) @db.Decimal(5, 4)
  updatedBy                     Int?
  updatedAt                     DateTime @default(now()) @db.DateTime(0)

  @@map("global_reorder_settings")
}

model ProductReorderConfig {
  id                    Int      @id @default(autoincrement())
  productId             Int      @unique
  leadTimeDays          Int? // NULL = inherit the global default
  customSafetyStockDays Int? // NULL = inherit the global bufferDays default
  minOrderQuantity      Int      @default(1)
  reorderPointOverride  Int? // NULL = compute; else pin the reorder point
  createdAt             DateTime @default(now()) @db.DateTime(0)
  updatedAt             DateTime @updatedAt @db.DateTime(0)
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId], map: "idx_reorder_config_product")
  @@map("product_reorder_configs")
}

model StagingItem {
  id                Int               @id @default(autoincrement())
  description       String            @db.VarChar(255)
  status            StagingItemStatus @default(RECEIVED)
  expectedQuantity  Int?
  countedQuantity   Int?
  resolvedProductId Int?
  vendor            String?           @db.VarChar(255)
  reference         String?           @db.VarChar(255)
  notes             String?           @db.Text
  locationId        Int
  receivedBy        Int
  receivedAt        DateTime          @default(now()) @db.DateTime(0)
  graduatedBy       Int?
  graduatedAt       DateTime?         @db.DateTime(0)
  createdAt         DateTime          @default(now()) @db.DateTime(0)
  updatedAt         DateTime          @updatedAt @db.DateTime(0)
  // Inventory-accuracy lane (pack REV-2 T1). shipmentId is a SOFT ref to
  // inbound_shipments.id — cross-aggregate, so no relation and no FK. countedBy
  // is an ACTOR column, so it takes the house relation (receivedBy precedent);
  // the soft-ref rule is scoped to cross-aggregate references only.
  shipmentId        String?           @db.VarChar(30)
  unitCostCents     Int?
  countedBy         Int?
  countedAt         DateTime?

  receivedByUser  User     @relation("StagingReceivedBy", fields: [receivedBy], references: [id])
  graduatedByUser User?    @relation("StagingGraduatedBy", fields: [graduatedBy], references: [id])
  countedByUser   User?    @relation("StagingCountedBy", fields: [countedBy], references: [id])
  resolvedProduct Product? @relation("StagingResolvedProduct", fields: [resolvedProductId], references: [id])
  location        Location @relation(fields: [locationId], references: [id])

  @@index([status, locationId, receivedAt], map: "idx_staging_status_loc_time")
  @@index([receivedBy], map: "idx_staging_received_by")
  @@index([resolvedProductId], map: "idx_staging_resolved_product")
  @@index([shipmentId])
  @@map("staging_items")
}

model Location {
  id                  Int                    @id
  name                String                 @db.VarChar(100)
  inventory_logs      inventory_logs[]
  product_locations   product_locations[]
  notificationHistory NotificationHistory[]
  users               User[]
  stagingItems        StagingItem[]
  stockSnapshots      ProductStockSnapshot[]

  @@map("locations")
}

model inventory_logs {
  id            Int                    @id @default(autoincrement())
  userId        Int?
  productId     Int
  delta         Int
  changeTime    DateTime               @db.DateTime(3)
  locationId    Int?
  logType       inventory_logs_logType @default(ADJUSTMENT)
  transferId    String?                @db.VarChar(36)
  actorKind     String                 @default("USER") @db.VarChar(16)
  reasonCode    String?                @db.VarChar(20)
  unitCostCents Int?
  batchId       String?                @db.VarChar(36)
  // Inventory-accuracy lane (pack REV-2 T1). BOTH are SOFT refs — no relation,
  // no FK (the cross-aggregate rule). orderRecordId -> external_orders.id (cuid,
  // VarChar(191)); inboundShipmentId -> inbound_shipments.id. orderRecordId is
  // the FINAL name: the prod-only `externalOrderId` column on this table is an
  // INT with an FK to a legacy-preserve table and can never be adopted.
  orderRecordId     String?            @db.VarChar(191)
  inboundShipmentId String?            @db.VarChar(30)
  locations     Location?              @relation(fields: [locationId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_log_location")
  users         User?                  @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "inventory_logs_ibfk_1")
  products      Product                @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "inventory_logs_ibfk_2")

  @@index([locationId], map: "fk_log_location")
  @@index([productId, locationId, changeTime], map: "idx_inventory_logs_product_location_time_desc")
  @@index([logType, changeTime], map: "idx_inventory_logs_type_time")
  @@index([logType, productId, changeTime], map: "idx_inventory_logs_type_product_time")
  @@index([userId, changeTime, productId, locationId, delta], map: "idx_inventory_logs_user_covering")
  // Indices for reports system performance
  @@index([changeTime, productId, delta], map: "idx_logs_time_product_delta")
  @@index([productId, changeTime, delta], map: "idx_logs_product_time_delta")
  @@index([batchId], map: "idx_inventory_logs_batch")
  @@index([changeTime, productId, userId], map: "idx_inventory_logs_recent_changes")
  @@index([orderRecordId])
  @@index([inboundShipmentId])
}

model product_locations {
  id          Int      @id @default(autoincrement())
  productId   Int
  locationId  Int
  quantity    Int      @default(0)
  /// Per-location minimum on hand; 0 disables the trigger
  minQuantity Int      @default(0)
  version     Int      @default(0)
  updatedAt   DateTime @default(now()) @updatedAt @db.DateTime(0)
  locations   Location @relation(fields: [locationId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pl_location")
  products    Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pl_product")

  @@unique([productId, locationId], map: "unique_product_location")
  @@index([locationId], map: "fk_pl_location")
  @@index([version, updatedAt], map: "idx_product_locations_version")
  @@index([updatedAt], map: "idx_product_locations_updated")
  @@index([productId, locationId, quantity], map: "idx_product_locations_lookup_covering")
  @@index([locationId, productId], map: "idx_product_locations_by_location")
  @@index([quantity, productId], map: "idx_product_locations_low_stock")
}

model NotificationHistory {
  id               Int       @id @default(autoincrement())
  userId           Int
  productId        Int
  locationId       Int?
  notificationType String    @db.VarChar(50)
  sentAt           DateTime? @default(now()) @db.DateTime(0)
  location         Location? @relation(fields: [locationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products         Product   @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notif_product")
  users            User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notif_user")

  @@index([userId, productId, locationId, notificationType], map: "idx_user_product_loc_type")
  @@index([userId, productId, notificationType], map: "idx_user_product_type")
  @@index([productId], map: "idx_notif_product")
  @@map("notification_history")
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  userId        Int?
  actorKind     String   @default("USER") @db.VarChar(16)
  companyId     String?  @db.VarChar(30)
  actionType    String   @db.VarChar(50)
  entityType    String   @db.VarChar(50)
  entityId      String?  @db.VarChar(64)
  batchId       String?  @db.VarChar(36)
  action        String   @db.Text
  details       Json?
  ipAddress     String?  @db.VarChar(45)
  userAgent     String?  @db.VarChar(255)
  affectedCount Int      @default(1)
  createdAt     DateTime @default(now()) @db.DateTime(3)
  user          User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_user")

  @@index([userId], map: "idx_audit_user")
  @@index([actionType], map: "idx_audit_actionType")
  @@index([entityType, entityId, createdAt], map: "idx_audit_entity_time")
  @@index([batchId], map: "idx_audit_batch")
  @@index([createdAt], map: "idx_audit_created")
  @@index([companyId, createdAt], map: "idx_audit_company_time")
  @@map("audit_logs")
}

model SystemSetting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @default(now()) @updatedAt @db.DateTime(0)

  @@map("system_settings")
}

enum inventory_logs_logType {
  ADJUSTMENT
  TRANSFER
  STOCK_IN
  SALE
  CORRECTION
  COUNT
}

enum ProductApprovalStatus {
  APPROVED
  PENDING_REVIEW
}

enum StagingItemStatus {
  RECEIVED
  GRADUATED
  DISCARDED
}

// Organizational Layer
model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        UserCompany[]
  integrations Integration[]
  orders       ExternalOrder[]
  salesFacts   ProductSalesFact[]
  // Products are GLOBAL (shared inventory) - accessed via ProductLink through integrations

  @@map("companies")
}

model UserCompany {
  userId    Int
  companyId String
  user      User    @relation(fields: [userId], references: [id])
  company   Company @relation(fields: [companyId], references: [id])

  @@id([userId, companyId])
  @@map("user_companies")
}

// Integration Layer
model Integration {
  id        String @id @default(cuid())
  companyId String
  platform  String @db.VarChar(50) // "SHOPIFY", "WOOCOMMERCE"
  name      String @db.VarChar(255)
  storeUrl  String @db.VarChar(500)

  // R-E8 credential split. WooCommerce API keys carry Read / Write / Read-Write
  // permission — NOT per-endpoint scope — so a write-capable key can write ORDERS.
  // Splitting the pair is what makes ~95% of the code that touches the platform
  // physically incapable of writing, regardless of any future bug or AI edit:
  //
  //   encryptedRead*  — a Woo READ-permission key. Used by every read path.
  //   encryptedWrite* — the write-capable pair. Resolvable ONLY by the two egress
  //                     write functions. Absent => every write blocks with
  //                     reason "no_write_credential".
  //
  // The Write pair is the RENAME of the historical encryptedApiKey/Secret, so no
  // key has to be re-entered on deploy.
  encryptedWriteKey    String? @db.Text
  encryptedWriteSecret String? @db.Text
  encryptedReadKey     String? @db.Text
  encryptedReadSecret  String? @db.Text

  // Webhook SIGNING secret. Deliberately separate from the API credentials — see
  // the REV-2 #11 landmine note in app/api/webhooks/[integrationId]/route.ts.
  webhookSecret String? @db.Text

  isActive   Boolean   @default(true)
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Stock sync & fulfillment push configuration (Phase D)
  stockSyncEnabled       Boolean   @default(false)
  fulfillmentPushEnabled Boolean   @default(false)
  lastStockSyncAt        DateTime?
  lastStockSyncError     String?   @db.Text
  // Phase B (R-D2): durable failure signal for the order-sync job (cron + manual
  // trigger). Success clears it; recordIngestion onFailure and per-run error
  // summaries write it. Parallel to lastStockSyncError / lastWebhookError.
  lastSyncError String? @db.Text
  syncLocationId         Int? // Which location to sync stock from (null = all locations)

  // P1-3 hardening: timestamp-based sync lock. Replaces the GET_LOCK approach
  // which was unreliable under Prisma connection pooling. Stale locks (older
  // than 5 minutes) are treated as expired by the acquire query.
  syncLockedAt DateTime?

  // Phase 7c: webhook delivery health visibility
  lastWebhookReceivedAt DateTime?
  lastWebhookError      String?   @db.Text
  webhookFailureCount   Int       @default(0)

  company           Company            @relation(fields: [companyId], references: [id])
  orders            ExternalOrder[]
  productLinks      ProductLink[]
  salesFacts        ProductSalesFact[]
  webhookDeliveries WebhookDelivery[]
  writeAttempts     PlatformWriteAttempt[]
  // Lane 6 (L-WOO): the read-only fulfillment observation feed.
  fulfillmentObservations FulfillmentObservation[]
  fulfillmentSyncState    FulfillmentSyncState?
  fulfillmentHints        FulfillmentObservationHint[]

  @@index([companyId])
  @@index([platform])
  @@map("integrations")
}

/**
 * Lane 6 (T2) — the pre-send authorization record for EVERY attempted platform
 * write: allowed, blocked, or dry-run. A row is COMMITTED before any byte leaves
 * the process; if it cannot be written, the send is refused (codex #13).
 *
 * REV-2 #21: this table deliberately does NOT cascade-delete with Integration —
 * deleting an integration must never destroy the safety record of what that
 * integration was used to attempt. The FK is nullable + SetNull, and
 * integrationLabel/platform are denormalized so a detached row is still legible.
 *
 * REV-2 #22: `state` is an explicit machine, not a nullable outcome. A nullable
 * outcome cannot distinguish "crashed before send" from "crashed after send" —
 * which is the first question anyone asks after an incident.
 */
model PlatformWriteAttempt {
  id Int @id @default(autoincrement())

  // Nullable + SetNull (REV-2 #21). Never `onDelete: Cascade`.
  integrationId String?
  // Denormalized, immutable identity — survives integration deletion.
  integrationLabel String @db.VarChar(255)
  platform         String @db.VarChar(32)

  capability String  @db.VarChar(32) // stock_status | order_status
  method     String  @db.VarChar(8)
  url        String  @db.VarChar(500)
  bodyDigest String  @db.Char(64) // sha256 — the body itself is NEVER stored
  decision   String  @db.VarChar(16) // allow | block | dry_run
  blockReason String? @db.VarChar(32)

  // authorized | sent | response_received | outcome_unknown | blocked | dry_run
  state      String @db.VarChar(24)
  httpStatus Int?

  /** 1 = first attempt, 2 = the single permitted 429 retry (REV-2 #6). */
  attemptNo Int @default(1)

  /**
   * The exact config this attempt was authorized under (REV-2 #4). Re-derived
   * from a fresh read immediately before the wire call; a mismatch aborts the
   * send rather than letting it go out under a stale authorization.
   */
  configFingerprint String @db.Char(64)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  integration Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([integrationId, createdAt])
  @@index([state, createdAt])
  @@map("platform_write_attempts")
}

enum WebhookDeliveryStatus {
  PROCESSING
  PROCESSED
  FAILED
}

model WebhookDelivery {
  id            Int                   @id @default(autoincrement())
  integrationId String
  bodyDigest    String                @db.Char(64)
  eventId       String?               @db.VarChar(128)
  status        WebhookDeliveryStatus @default(PROCESSING)
  claimedAt     DateTime              @default(now()) @db.DateTime(3)
  processedAt   DateTime?             @db.DateTime(3)
  receivedAt    DateTime              @default(now()) @db.DateTime(3)
  integration   Integration           @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, bodyDigest])
  @@index([receivedAt])
  @@map("webhook_deliveries")
}

// Product Linking Layer
model ProductLink {
  id                String   @id @default(cuid())
  integrationId     String
  internalProductId Int?
  externalProductId String   @db.VarChar(255)
  externalVariantId String?  @db.VarChar(255)
  externalSku       String?  @db.VarChar(255)
  externalTitle     String?  @db.VarChar(500)
  isBundle          Boolean  @default(false)
  createdAt         DateTime @default(now())

  integration      Integration         @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  internalProduct  Product?            @relation(fields: [internalProductId], references: [id])
  bundleComponents BundleComponent[]
  orderItems       ExternalOrderItem[]
  priceSourceFor   Product[]           @relation("PriceSource")

  @@unique([integrationId, externalProductId, externalVariantId])
  @@index([internalProductId])
  @@index([isBundle])
  @@map("product_links")
}

model BundleComponent {
  id                String @id @default(cuid())
  productLinkId     String
  internalProductId Int
  quantity          Int    @default(1)
  sortOrder         Int    @default(0)

  productLink     ProductLink @relation(fields: [productLinkId], references: [id], onDelete: Cascade)
  internalProduct Product     @relation(fields: [internalProductId], references: [id])

  @@unique([productLinkId, internalProductId])
  @@index([internalProductId])
  @@map("bundle_components")
}

// Order Storage Layer
model ExternalOrder {
  id            String @id @default(cuid())
  companyId     String
  integrationId String

  externalId  String @db.VarChar(255)
  orderNumber String @db.VarChar(100)

  nativeStatus      String  @db.VarChar(100)
  financialStatus   String? @db.VarChar(100)
  fulfillmentStatus String? @db.VarChar(100)

  // Source-of-truth status info (platform-specific, verbatim)
  platformStatusRaw  Json?
  externalStatusHash String? @db.VarChar(64)
  externalOrderUrl   String? @db.VarChar(500)

  total         Decimal @db.Decimal(10, 2)
  currency      String  @default("USD") @db.VarChar(10)
  customerEmail String? @db.VarChar(255)
  customerName  String? @db.VarChar(255)

  rawPayload Json

  internalStatus String    @default("pending") @db.VarChar(50)
  fulfilledAt    DateTime?
  fulfilledBy    Int?

  // Stocked Out: tracks whether physical inventory has been deducted,
  // independent of the WC order lifecycle (internalStatus).
  stockedOut   Boolean   @default(false)
  stockedOutAt DateTime?
  stockedOutBy Int?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  externalCreatedAt DateTime?
  externalUpdatedAt DateTime?
  lastSeenAt        DateTime?

  company         Company             @relation(fields: [companyId], references: [id])
  integration     Integration         @relation(fields: [integrationId], references: [id])
  items           ExternalOrderItem[]
  fulfilledByUser User?               @relation(fields: [fulfilledBy], references: [id])

  @@unique([integrationId, externalId])
  @@index([companyId, internalStatus])
  @@index([companyId, createdAt])
  @@index([integrationId, externalUpdatedAt])
  @@index([stockedOut], map: "idx_stocked_out")
  @@index([updatedAt], map: "external_orders_updatedAt_idx")
  @@map("external_orders")
}

// Order Items Layer
model ExternalOrderItem {
  id      String @id @default(cuid())
  orderId String

  externalItemId    String? @db.VarChar(255)
  externalProductId String  @db.VarChar(255)
  externalVariantId String? @db.VarChar(255)

  name         String  @db.VarChar(500)
  variantName  String? @db.VarChar(500)
  sku          String? @db.VarChar(255)
  quantity     Int
  fulfilledQty Int     @default(0)
  price        Decimal @db.Decimal(10, 2)

  productLinkId           String?
  isMapped                Boolean @default(false)
  bundleComponentSnapshot Json?

  order       ExternalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productLink ProductLink?  @relation(fields: [productLinkId], references: [id], onDelete: SetNull)

  @@unique([orderId, externalItemId], map: "idx_order_item_unique")
  @@index([orderId])
  @@index([externalVariantId])
  @@map("external_order_items")
}

// ---------------------------------------------------------------------------
// Lane 6 — L-WOO: read-only WooCommerce fulfillment observation feed (spec §4).
//
// Woo core has NO per-item fulfillment quantity (the native Order Fulfillments
// feature is beta + disabled by default — revisit at GA). So the ONLY thing we
// can truthfully prove is "units on a COMPLETED order", attributed to
// date_completed_gmt. This is NEVER "fulfilled quantity" — partial per-item
// fulfillment stays null-with-reason until Woo GAs the feature.
//
// Grain is LINE ITEM (REV-2 #18): one row per (order, item), and a bundle line
// expands into one row per FROZEN component. productId is resolved via
// product_links (the mapping); null means UNMAPPED (coverage, NOT zero).
// ---------------------------------------------------------------------------
model FulfillmentObservation {
  id              Int    @id @default(autoincrement())
  integrationId   String
  externalOrderId String @db.VarChar(64)
  // Synthetic per-observation key. A simple line uses the Woo line-item id; a
  // bundle component uses "<lineItemId>:c:<internalProductId>" so each frozen
  // component is its own idempotent row under the unique constraint.
  externalItemId String @db.VarChar(64)

  // Resolved via product_links; null = unmapped (coverage, NOT zero).
  productId Int?

  // Sum of line_items[].quantity counted as ON A COMPLETED ORDER: 0 when the
  // order is not currently `completed` (fully-refunded orders are `refunded`, so
  // they resolve to 0 and drop out). For a bundle component this is
  // lineQty * componentQty (the frozen expansion). NEVER "fulfilled quantity".
  unitsOnCompletedOrder Int

  orderStatus String    @db.VarChar(24)
  completedAt DateTime? @db.DateTime(3) // date_completed_gmt (the GMT field, always)

  // date_modified_gmt — THE watermark. An incoming observation is applied only
  // when STRICTLY NEWER than the stored one (REV-2 #21) — so a late webhook hint
  // or a slow poll can never overwrite fresher state.
  sourceModifiedAt DateTime @db.DateTime(3)

  // Refund posture (REV-2 #26). Derived from ORDER-LEVEL refund records + status,
  // NEVER from Woo's documented-buggy per-line refund quantities.
  hasPartialRefund Boolean @default(false)
  isFullyRefunded  Boolean @default(false)

  // Set when the order vanished from Woo (deleted/trashed): the seen-set
  // reconciliation tombstones it and it drops out of totals (REV-2 #24). A later
  // re-observation of a restored order clears it.
  tombstonedAt DateTime? @db.DateTime(3)

  // Telemetry drift, expected (REV-2 #27): bumped on every observation, never a
  // business field. Idempotence is defined over the business columns only.
  lastObservedAt DateTime @db.DateTime(3)

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, externalOrderId, externalItemId], map: "fulfillment_obs_integration_order_item_key")
  @@index([completedAt])
  @@index([integrationId, tombstonedAt])
  @@index([productId])
  @@map("fulfillment_observations")
}

// The durable per-integration fulfillment sync cursor + backfill job state
// (REV-2 #22/#23/#28). Deliberately NOT Integration.lastSyncAt — webhooks
// advance lastSyncAt to wall-clock, which would corrupt an incremental cursor.
model FulfillmentSyncState {
  integrationId String @id

  // Incremental cursor: the frozen upper watermark of the last run in which
  // EVERY page succeeded. Next run queries modified_after = cursor - overlap.
  // Advanced ONLY after a fully-successful run; any error retains it.
  cursorModifiedAt DateTime? @db.DateTime(3)

  // Backfill (REV-2 #28) — resumable: a saved page + a FROZEN upper bound so
  // pagination stays stable and a crash resumes without double-counting.
  backfillPage     Int?
  backfillBefore   DateTime? @db.DateTime(3)
  backfillComplete Boolean   @default(false)

  // Heartbeat lease — same shape as the analytics rebuild lock (lib/analytics).
  // A live job heartbeats under the lease; a crashed job's lease expires and is
  // re-acquirable.
  lockedAt    DateTime? @db.DateTime(3)
  heartbeatAt DateTime? @db.DateTime(3)

  lastRunAt DateTime? @db.DateTime(3)
  lastError String?   @db.Text
  updatedAt DateTime  @default(now()) @updatedAt @db.DateTime(3)

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@map("fulfillment_sync_state")
}

// Webhook latency HINT (REV-2 #15). The webhook, AFTER verifying the signature,
// upserts a hint and returns — it NEVER does a synchronous Woo GET (a GET
// failure would count toward Woo's 5-strike webhook auto-disable). The poll is
// the source of truth; it consumes unprocessed hints by GETting current state.
model FulfillmentObservationHint {
  id              Int       @id @default(autoincrement())
  integrationId   String
  externalOrderId String    @db.VarChar(64)
  receivedAt      DateTime  @default(now()) @db.DateTime(3)
  processedAt     DateTime? @db.DateTime(3)

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, externalOrderId])
  @@index([processedAt])
  @@map("fulfillment_observation_hints")
}

model ProductStockSnapshot {
  id         Int      @id @default(autoincrement())
  productId  Int
  locationId Int
  dayKey     String   @db.Char(10)
  quantity   Int
  createdAt  DateTime @default(now()) @db.DateTime(0)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId, dayKey], map: "uq_snapshot_grain")
  @@index([dayKey], map: "idx_snapshot_day")
  @@index([productId, dayKey], map: "idx_snapshot_product_day")
  @@map("product_stock_snapshots")
}

model ProductSalesFact {
  id            Int      @id @default(autoincrement())
  productId     Int
  companyId     String
  integrationId String
  dayKey        String   @db.Char(10)
  orderedQty    Int      @default(0)
  fulfilledQty  Int      @default(0)
  revenue       Decimal  @default(0.00) @db.Decimal(12, 2)
  orderCount    Int      @default(0)
  createdAt     DateTime @default(now()) @db.DateTime(0)
  updatedAt     DateTime @default(now()) @updatedAt @db.DateTime(0)

  product     Product     @relation(fields: [productId], references: [id])
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([productId, companyId, integrationId, dayKey], map: "uq_sales_fact_grain")
  @@index([companyId, dayKey], map: "idx_sales_fact_company_day")
  @@index([productId, dayKey], map: "idx_sales_fact_product_day")
  @@index([companyId, productId, dayKey], map: "idx_sales_fact_company_product_day")
  @@map("product_sales_facts")
}

model AnalyticsRebuildState {
  job             String    @id @db.VarChar(32)
  lockedAt        DateTime? @db.DateTime(3)
  heartbeatAt     DateTime? @db.DateTime(3)
  lastRunAt       DateTime? @db.DateTime(0)
  lastWindowFrom  String?   @db.Char(10)
  lastWindowTo    String?   @db.Char(10)
  rowsDeleted     Int       @default(0)
  rowsInserted    Int       @default(0)
  unattributed    Int       @default(0)
  flaggedPairs    Int       @default(0)
  sourceWatermark DateTime? @db.DateTime(0)
  lastError       String?   @db.Text
  updatedAt       DateTime  @default(now()) @updatedAt @db.DateTime(0)

  @@map("analytics_rebuild_state")
}

// Lane 3 (spec D8 / R-L14): per-run operational telemetry for the analytics
// rebuild jobs. Small dedicated table (NOT audit_logs) — rebuild runs are
// telemetry, not entity changes. Retention = keep newest 100 per job.
model AnalyticsRebuildRun {
  id                Int       @id @default(autoincrement())
  job               String    @db.VarChar(32)
  mode              String    @db.VarChar(16)
  source            String    @db.VarChar(16)
  status            String    @db.VarChar(16)
  requestedByUserId Int?
  startedAt         DateTime  @db.DateTime(3)
  finishedAt        DateTime? @db.DateTime(3)
  durationMs        Int?
  windowFrom        String?   @db.Char(10)
  windowTo          String?   @db.Char(10)
  rowsDeleted       Int       @default(0)
  rowsInserted      Int       @default(0)
  unattributed      Int       @default(0)
  flaggedPairs      Int       @default(0)
  sourceWatermark   DateTime? @db.DateTime(0)
  skippedReason     String?   @db.VarChar(64)
  error             String?   @db.Text

  @@index([job, startedAt], map: "idx_rebuild_runs_job_started")
  @@map("analytics_rebuild_runs")
}

// ---------------------------------------------------------------------------
// Lane 4 — AI layer (spec D2/D7/R-A4). Additive v1 tables. Prisma mirrors of the
// hand-authored migration `<ts>_lane4_ai_layer` (applied only by compose
// migrate). NO defaultModel column anywhere (spec D-B8: routing defaults carry
// {provider, model}; per-provider preference is redundant state).
// ---------------------------------------------------------------------------

// Admin-configured AI providers (spec D2). Singleton-per-kind (UNIQUE kind).
// Keys encrypted at rest via lib/encryption (encryptedApiKey; OLLAMA has none).
// Disable-only in v1 (no delete route) so past activity stays attributable.
model AiProvider {
  id              String   @id @default(cuid()) @db.VarChar(30)
  kind            String   @unique(map: "uq_ai_providers_kind") @db.VarChar(16)
  encryptedApiKey String?  @db.Text
  baseUrl         String?  @db.VarChar(500)
  enabledModels   Json
  isEnabled       Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.DateTime(3)
  updatedAt       DateTime @updatedAt @db.DateTime(3)

  @@map("ai_providers")
}

// Machine-client API tokens for the MCP sidecar (spec D7). Read-tier, hashed
// (sha256 hex in tokenHash — the plaintext is shown once, never stored),
// revocable, owner-scoped. TWO named User relations: the human who created it
// and the owner whose company access it inherits.
model ApiToken {
  id              String    @id @default(cuid()) @db.VarChar(30)
  name            String    @db.VarChar(64)
  tokenHash       String    @unique(map: "uq_api_tokens_hash") @db.Char(64)
  tier            String    @default("read") @db.VarChar(8)
  createdByUserId Int
  ownerUserId     Int
  createdAt       DateTime  @default(now()) @db.DateTime(3)
  lastUsedAt      DateTime? @db.DateTime(3)
  revokedAt       DateTime? @db.DateTime(3)

  owner     User @relation("ApiTokenOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_api_tokens_owner")
  createdBy User @relation("ApiTokenCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_api_tokens_creator")

  @@index([ownerUserId], map: "idx_api_tokens_owner")
  @@index([createdByUserId], map: "idx_api_tokens_creator")
  @@map("api_tokens")
}

// Read-telemetry: one row per tool invocation from BOTH surfaces (assistant +
// mcp) (spec R-A4). Metadata ONLY — never prompts, args, or results. No FK on
// userId/tokenId (decoupled telemetry; retention prune keep-newest-10k).
model AssistantRun {
  id           Int      @id @default(autoincrement())
  userId       Int?
  tokenId      String?  @db.VarChar(30)
  requestId    Int?     // assistant_requests correlation; NULL on the MCP surface (no request envelope). No FK — see above.
  surface      String   @db.VarChar(12)
  providerKind String?  @db.VarChar(16)
  model        String?  @db.VarChar(64)
  toolName     String   @db.VarChar(48)
  outcome      String   @db.VarChar(16)
  durationMs   Int
  resultBytes  Int
  createdAt    DateTime @default(now()) @db.DateTime(3)

  @@index([createdAt], map: "idx_assistant_runs_created")
  @@index([userId, createdAt], map: "idx_assistant_runs_user")
  @@index([requestId], map: "idx_assistant_runs_request")
  @@map("assistant_runs")
}

// Per-user assistant conversation threads (multiuser spec C1). Ownership is
// absolute: every route derives userId from the session; no cross-user reads.
model AssistantThread {
  id        String   @id @default(cuid()) @db.VarChar(30)
  userId    Int
  title     String?  @db.VarChar(120)      // model-generated (C6); null until set
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_assistant_threads_user")
  messages AssistantMessage[]
  requests AssistantRequest[]

  @@index([userId, updatedAt], map: "idx_assistant_threads_user_updated")
  @@map("assistant_threads")
}

// One row per persisted UIMessage. COMPOSITE PK (threadId, id): message ids are
// per-thread, so a client-supplied id can never collide across threads (no
// enumeration oracle — G1). Assistant ids are server-generated (C3); user ids
// are client-supplied and validated.
model AssistantMessage {
  threadId  String   @db.VarChar(30)
  id        String   @db.VarChar(40)
  role      String   @db.VarChar(12)       // "user" | "assistant" | "system"
  parts     Json                            // ai-sdk UIMessage parts (sanitized per C4)
  metadata  Json?                           // terminal turn metadata: { finishReason?, aborted?, errorCode? } (C4)
  sequence  Int                             // server-assigned inside the claim tx (C2)
  createdAt DateTime @default(now()) @db.DateTime(3)

  thread AssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade, map: "fk_assistant_messages_thread")

  @@id([threadId, id])
  @@unique([threadId, sequence], map: "uq_assistant_messages_thread_seq")
  @@map("assistant_messages")
}

// One row per model REQUEST (chat turn or title call). The audit/usage record:
// kept indefinitely; survives thread deletion (SetNull). userId is a bare
// column (assistant_runs precedent — decoupled; NOTE users are SOFT-deleted in
// this app, schema.prisma:17, so the User Cascade on threads never fires in
// practice — a soft-deleted user's threads persist unreachable behind auth).
model AssistantRequest {
  id              Int      @id @default(autoincrement())
  threadId        String?  @db.VarChar(30)
  userId          Int
  kind            String   @db.VarChar(8)    // "chat" | "title"
  providerKind    String   @db.VarChar(16)
  model           String   @db.VarChar(64)
  inputTokens     Int?                        // as reported; NULL = not reported (G2)
  outputTokens    Int?
  totalTokens     Int?
  durationMs      Int?
  status          String   @db.VarChar(16)    // "running" | "ok" | "aborted" | "error"
  errorCode       String?  @db.VarChar(32)    // masked route vocabulary only
  membershipScope Json                        // companyIds snapshot at request time (v1.1 audit substrate)
  dayKey          String   @db.Char(10)       // UTC YYYY-MM-DD computed at insert (C8 rollups; house ProductSalesFact precedent)
  createdAt       DateTime @default(now()) @db.DateTime(3)

  thread AssistantThread? @relation(fields: [threadId], references: [id], onDelete: SetNull, map: "fk_assistant_requests_thread")

  @@index([userId, dayKey], map: "idx_assistant_requests_user_day")
  @@index([threadId, status], map: "idx_assistant_requests_thread_status")
  @@index([createdAt], map: "idx_assistant_requests_created")
  @@map("assistant_requests")
}

// Bounded live-eval reports + user reports (C9; Kris decision 3). Small table.
// Source-discriminated (G2C-9): "eval-run" rows REQUIRE model + corpusRev
// (validated at the upload route); "user-report" rows leave them NULL (a prod
// user report has no corpus revision and may span models — fabricating values
// would be untruthful). environment vocabulary includes "production".
model AssistantEvalReport {
  id          Int      @id @default(autoincrement())
  runAt       DateTime @db.DateTime(3)
  environment String   @db.VarChar(16)     // "dev" | "staging" | "production"
  model       String?  @db.VarChar(64)     // eval-run only
  corpusRev   String?  @db.VarChar(64)     // eval-run only
  source      String   @db.VarChar(16)     // "eval-run" | "user-report" (C9)
  report      Json                          // scored report / reported-thread excerpt (C9 schemas)
  createdAt   DateTime @default(now()) @db.DateTime(3)

  @@map("assistant_eval_reports")
}

// ---------------------------------------------------------------------------
// Inventory-accuracy lane (contract pack REV-2 T1) — the whole lane's schema
// rides ONE additive migration. The staging_items / inventory_logs additions
// live with their models above; the two new tables are here.
// ---------------------------------------------------------------------------

// Thin receiving header. Lines live on staging_items (soft-linked via
// shipmentId), so a shipment carries no quantities of its own and the
// discrepancy rollup is COMPUTED ON READ from the linked rows (T4 — deliberately
// no stored column). cancelledBy is carried by the audit line, not a column.
model InboundShipment {
  id          String                @id @default(cuid()) @db.VarChar(30)
  supplierRef String?               @db.VarChar(255)
  status      InboundShipmentStatus @default(OPEN)
  createdBy   Int
  closedBy    Int?
  notes       String?               @db.Text
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  closedAt    DateTime?
  creator     User                  @relation("shipmentCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("inbound_shipments")
}

enum InboundShipmentStatus {
  OPEN
  CLOSED
  CANCELLED
}

// One row per accuracy exception, upserted on `key`. `kind` is a CLOSED
// vocabulary (W1 writes recv-discrepancy / pending-with-stock / cost-differs;
// W3 adds unattributed-outstock / unmapped-lines / gap-order) and severity is
// DERIVED from kind at read time — deliberately no column. `subject` carries the
// named payload INCLUDING the values, so a tolerance chosen at the checkpoint
// applies retroactively. WRITE BOUNDARY: rows are written ONLY by explicitly-
// mutating routes; no GET and no assistant tool ever writes one.
model InventoryException {
  id          Int       @id @default(autoincrement())
  key         String    @unique @db.VarChar(191)
  kind        String    @db.VarChar(32)
  subject     Json
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime
  resolvedAt  DateTime?
  resolvedBy  Int?
  note        String?   @db.Text

  @@map("inventory_exceptions")
}
