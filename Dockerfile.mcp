# syntax=docker/dockerfile:1
#
# Read-only MCP sidecar (Lane 4, spec D8). Multi-stage node:22-alpine:
#   deps    -> install the repo's dependencies (root lockfile)
#   builder -> generate the Prisma client + bundle mcp/src/server.ts with the repo's
#              pinned tsup config (externalises node_modules; @/lib/* is bundled)
#   runner  -> run the ESM bundle as a non-root user, HEALTHCHECK on /healthz
#
# Build context is the repo root (docker-compose: `context: .`). The bundle imports
# ONLY the framework-neutral lib/assistant modules + the Prisma client — never next/*
# or lib/api-utils.

FROM node:22-alpine AS deps
WORKDIR /app
RUN apk add --no-cache libc6-compat
COPY package.json package-lock.json* ./
RUN npm ci --ignore-scripts

FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# Generate the Prisma client (deps installed with --ignore-scripts) then bundle the
# sidecar. tsup runs from mcp/ so its entry (src/server.ts) + config resolve.
RUN npm run db:generate
RUN cd mcp && npx --no-install tsup

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV TZ=UTC
ENV MCP_PORT=8080

RUN apk add --no-cache curl
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 mcp

# node_modules carries the runtime externals (ai, @modelcontextprotocol/sdk, zod,
# @prisma/client + the generated client). mcp/package.json (type: module) makes the
# bundled dist/server.js load as ESM.
COPY --from=builder --chown=mcp:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=mcp:nodejs /app/mcp/dist ./mcp/dist
COPY --from=builder --chown=mcp:nodejs /app/mcp/package.json ./mcp/package.json
COPY --from=builder --chown=mcp:nodejs /app/prisma ./prisma

EXPOSE 8080
HEALTHCHECK --interval=20s --timeout=3s --retries=5 \
  CMD sh -lc "curl -sf http://127.0.0.1:${MCP_PORT:-8080}/healthz >/dev/null || exit 1"

USER mcp

CMD ["node", "mcp/dist/server.js"]
